#!/usr/bin/env bash
set -euo pipefail

die() { printf 'hermes provider-ready: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "must run as root"
[ "${1:-}" = "--inference-ok" ] \
  || die "run a real inference first, then use: sudo hermes-provider-ready --inference-ok"

runtime_env="${HERMES_RUNTIME_ENV:-/etc/subyard/hermes-runtime.env}"
[ -r "$runtime_env" ] || die "missing runtime contract"
# shellcheck disable=SC1090
. "$runtime_env"

HERMES_RUNTIME_ENV="$runtime_env" "$HERMES_PIN_CHECK" --runtime-only
[ -s "$HERMES_HOME/config.yaml" ] || die "run hermes setup model first"

if [ "${HERMES_PROVIDER_READY_SKIP_DOCTOR:-0}" != 1 ]; then
  runuser -u "$HERMES_DEV_USER" -- env \
    HOME="$HERMES_DEV_HOME" HERMES_HOME="$HERMES_HOME" \
    HERMES_DISABLE_LAZY_INSTALLS=1 \
    PLAYWRIGHT_BROWSERS_PATH="$HERMES_PLAYWRIGHT_BROWSERS_PATH" \
    AGENT_BROWSER_EXECUTABLE_PATH="$HERMES_BROWSER_EXECUTABLE" \
    PATH="$(dirname "$HERMES_NODE"):$HERMES_VENV/bin:/usr/local/bin:/usr/bin:/bin" \
    "$HERMES_VENV/bin/hermes" doctor
fi

tmp="$(mktemp "$HERMES_HOME/.provider-ready.XXXXXX")"
trap 'rm -f -- "$tmp"' EXIT
printf '%s\n' "$HERMES_COMMIT" > "$tmp"
chown root:root "$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$HERMES_HOME/.provider-ready"
trap - EXIT

systemctl daemon-reload
systemctl enable --now hermes-serve.service

status_file="$(mktemp)"
trap 'rm -f -- "$status_file"' EXIT
ready=0
for _ in $(seq 1 45); do
  if curl -fsS --max-time 2 "http://127.0.0.1:$HERMES_PORT/api/status" > "$status_file" \
    && "$HERMES_VENV/bin/python" - "$status_file" "$HERMES_VERSION" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    status = json.load(stream)
raise SystemExit(0 if status.get("version") == sys.argv[2] else 1)
PY
  then
    ready=1
    break
  fi
  sleep 1
done
[ "$ready" = 1 ] || die "service did not become ready"
printf 'hermes provider-ready OK: version=%s bind=127.0.0.1:%s\n' \
  "$HERMES_VERSION" "$HERMES_PORT"
