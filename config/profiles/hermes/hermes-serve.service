[Unit]
Description=Hermes Agent headless backend
Documentation=https://github.com/NousResearch/hermes-agent
Wants=network-online.target
After=network-online.target
ConditionPathExists=/srv/hermes/.provider-ready

[Service]
Type=simple
User=@DEV_USER@
Group=@DEV_GROUP@
WorkingDirectory=/srv/hermes/workspace
Environment=HOME=@DEV_HOME@
Environment=HERMES_HOME=/srv/hermes
Environment=HERMES_DISABLE_LAZY_INSTALLS=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/hermes-agent/playwright
Environment=AGENT_BROWSER_EXECUTABLE_PATH=@HERMES_BROWSER_EXECUTABLE@
Environment=PATH=/opt/hermes-agent/node/bin:/opt/hermes-agent/agent-browser/bin:/opt/hermes-agent/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=/srv/hermes/.serve.env
UMask=0077
ExecStartPre=/usr/local/libexec/subyard-hermes-pin-check
ExecStart=/opt/hermes-agent/venv/bin/hermes serve --host 127.0.0.1 --port 9119 --skip-build
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=120s

NoNewPrivileges=true
ProtectSystem=full
ReadOnlyPaths=/opt/hermes-agent
ReadWritePaths=/srv/hermes
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
