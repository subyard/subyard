# Dedicated VPN VM. Initialization does not publish a VPN endpoint.
YARD_TEMPLATE=amnezia
YARD_KIND=vm
YARD_IMAGE=images:debian/13/cloud
YARD_IMAGE_FALLBACK=images:ubuntu/24.04/cloud
# Cloud images reserve UID/GID 1000 for their distribution account.
DEV_UID=1001
ENVIRONMENT_PROFILES=amnezia
CODING_TOOL_INTEGRATIONS=
LIMITS_CPU=2
LIMITS_MEMORY=2GiB
VM_CPU_WEIGHT=1000
VM_FREE_PAGE_REPORTING=1
VM_PIN_IPV4=1
ROOT_DISK_SIZE=10GiB
SRV_VOLUME_TYPE=block
SRV_VOLUME_SIZE=2GiB
HOST_MOUNTS=
HOST_LINKS=
HOST_CLAUDE_MD=
HOST_CODEX_AGENTS_MD=
HOST_OPENCODE_AGENTS_MD=
YARD_CAPABILITIES=
YARD_CAPS=
YARD_DEVICES=
YARD_MOUNTS=
FORWARD_SSH_AGENT=0
DEV_SUDO=0
NESTED_E2E_VMS=0
SSH_PORT=2225
RESOURCE_VPN_IPV4=
RESOURCE_VPN_INTERFACE=
RESOURCE_VPN_PORT=51820
RESOURCE_VPN_ADMIN_PORT=2226
