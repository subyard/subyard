[Unit]
Description=Subyard Amnezia environment network boundary
After=network-online.target
Before=docker.service
Wants=network-online.target
RequiresMountsFor=/srv
AssertPathIsMountPoint=/srv
ConditionPathExists=/srv/amnezia/settings.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/local/lib/subyard-amnezia/runtime.py start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
