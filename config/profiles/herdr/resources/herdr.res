COMMAND=herdr
HANDLER=resources/herdr/handler.sh
TITLE="Herdr remote core"
PROXY="herdr-ssh HERDR_ADVERTISE_HOST HERDR_HOST_PORT tcp:127.0.0.1:22 owner-metadata-v1 tailscale-only"
ENDPOINT_DEFAULTS="tailscale-self 6768"
BOOTSTRAP=profile
ACTION="up up bootstrap-change recreatable"
ACTION="is-up is-up read-only not-needed"
ACTION="status status read-only not-needed"
ACTION="pair-list pair read-only not-needed"
ACTION="pair-existing pair read-only not-needed"
ACTION="pair-add pair security-change reversible"
ACTION="pair-revoke pair security-change reversible"
ACTION="sync sync bounded-write not-needed"
ACTION="update update yard-change recreatable"
ACTION="restart restart yard-change reversible"
ACTION="logs logs read-only not-needed"
ACTION="down down runtime-destruction irreversible"
BRINGUP=up
SHUTDOWN=down
