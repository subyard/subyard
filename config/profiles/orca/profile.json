{
  "schema_version": 1,
  "unmanaged_integrations": [
    {
      "id": "claude",
      "command": ["python3", "-B", "/usr/local/libexec/subyard/orca-registration/unmanaged_claude.py"],
      "detail": "Orca-installed Claude; self-updating, without managed commit approval, persistence or instructions. Enable the claude integration to manage it."
    }
  ],
  "settings": [
    {
      "name": "ORCA_ADVERTISE_HOST",
      "type": "string",
      "scopes": [
        "shipped",
        "host",
        "yard",
        "command"
      ],
      "application": "next-command",
      "syncable": true,
      "optional": true
    },
    {
      "name": "ORCA_HOST_PORT",
      "type": "port",
      "scopes": [
        "shipped",
        "host",
        "yard",
        "command"
      ],
      "application": "next-command",
      "syncable": true,
      "optional": true,
      "minimum": 1,
      "maximum": 65535,
      "host_listener": true
    }
  ],
  "runtime": {
    "activation_id": "orca-runtime",
    "projects_changed_hooks": ["/usr/local/libexec/subyard/projects-changed.d/orca"],
    "handler": "runtime.sh",
    "failure_scope": "yard"
  },
  "guest_environment": {
    "handler": "ssh-agent-environment.sh"
  }
}
