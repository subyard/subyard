{
  "schema_version": 1,
  "selected_provision_only": true,
  "owner_service": "profile.sh",
  "startup_readiness": "profile.sh",
  "runtime": {"activation_id": "telemetry-runtime-v2", "handler": "runtime.sh"},
  "native": [{"package": "cmd/telemetry", "path": "bin/subyard-telemetry"}],
  "advisories": {"storage-capacity": "raw OTLP is refused for space; inside the yard run /usr/local/lib/subyard-telemetry/subyard-telemetry prune --data-dir /var/lib/subyard/telemetry --older-than 60d"},
  "settings": [
    {"name": "TELEMETRY_DISK_BUDGET", "type": "size", "scopes": ["shipped", "host", "yard", "command"],
     "application": "next-command", "syncable": true, "default": "30GiB"}
  ]
}
