{
  "name_pattern": "[A-Za-z0-9_.:/-]{1,160}",
  "int_pattern": "[+]?[0-9]+|-0+",
  "time_pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])",
  "fields": {
    "agent_run_id": {"type": "name", "aliases": ["subyard.agent_run.id"]},
    "session_id": {"type": "name", "aliases": ["session.id", "conversation.id", "conversation_id"]},
    "turn_id": {"type": "name", "aliases": ["prompt.id", "turn.id"]},
    "native_agent_id": {"type": "name", "aliases": ["agent_id"]},
    "parent_native_agent_id": {"type": "name", "aliases": ["parent_agent_id"]},
    "request_id": {"type": "name", "required": true},
    "model": {"type": "name", "aliases": ["model.name", "gen_ai.request.model", "gen_ai.response.model"]},
    "tool_use_id": {"type": "name", "tool_required": true},
    "input_tokens": {"type": "int", "aliases": ["input_token_count"]},
    "cache_read_tokens": {"type": "int", "aliases": ["cached_token_count"]},
    "cache_write_tokens": {"type": "int", "aliases": ["cache_creation_tokens", "cache_write_token_count"]},
    "output_tokens": {"type": "int", "aliases": ["output_token_count"]},
    "reasoning_tokens": {"type": "int", "aliases": ["reasoning_token_count"]},
    "tool_output_bytes": {"type": "int"},
    "tool_result_bytes": {"type": "int", "aliases": ["tool_result_size_bytes"], "tool_required": true},
    "client": {"type": "enum", "values": ["claude", "codex"], "required": true},
    "request_identity": {"type": "enum", "values": ["provider", "native_log"], "required": true},
    "trigger": {"type": "enum", "values": ["new_prompt", "tool_result", "worker_result", "poll_unchanged"]}
  },
  "attributes": {
    "event.kind": {"type": "enum", "values": ["response.completed"]},
    "event.timestamp": {"type": "time"},
    "event.sequence": {"type": "int"}
  }
}
