[Unit]
Description=Synchronize enrolled Subyard encrypted credential ledgers
Documentation=man:systemd.service(5)

[Service]
Type=oneshot
ExecStart=@YARD_BIN@ _keys-auto-sync --if-due

# Verified runtime admission needs the host's root and operator ownership identities.
# Filesystem sandboxing in a user service implicitly remaps root, invalidating that proof.
# Keep unprivileged execution and privilege restrictions without a private user namespace.
NoNewPrivileges=true
RestrictSUIDSGID=true
