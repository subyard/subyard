# Dormant public profile; enable it explicitly with YARD_TEMPLATE=test-vms.
# L1 is a privileged VM host, not an agent workspace.

# Inner Incus creates the VMs; L1 remains a container.
YARD_KIND=container
NESTED_E2E_VMS=1
FORWARD_SSH_AGENT=0

# Each slot retains two stopped VMs between leases. Release never deletes them.
E2E_VM_SLOT_COUNT=2
E2E_VM_IMAGE=images:debian/13/cloud
E2E_VM_CPU=auto
E2E_VM_MEMORY=4GiB
E2E_VM_DISK=20GiB
E2E_VM_BOOT_TIMEOUT=300

# P1 controller admission is default-open through the bounded forced-command facade.
