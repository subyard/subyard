# Copy to ~/.config/subyard/yards/<name>/config.env.
# Source checkouts may instead use private/yards/<name>.env.

# Required: unique host loopback port.
SSH_PORT=2223

# Optional public yard template.
# YARD_TEMPLATE=test-vms

# Optional project EnvironmentProfile allowlist. It is independent of the yard name.
# ENVIRONMENT_PROFILES="android openclaw"

# Optional stronger yard boundary.
# YARD_KIND=vm

# Optional resource limits.
# LIMITS_CPU=8
# LIMITS_MEMORY=24GiB

# Optional coding-tool integrations, independently selectable from profiles.
# CODING_TOOL_INTEGRATIONS="codex pi"

# Empty values explicitly clear inherited wiring for an isolated yard.
# HOST_MOUNTS=
# HOST_LINKS=
# HOST_CLAUDE_MD=
# HOST_CODEX_AGENTS_MD=
# HOST_OPENCODE_AGENTS_MD=
# YARD_CAPABILITIES=
# YARD_CAPS=
# YARD_DEVICES=
# YARD_MOUNTS=
