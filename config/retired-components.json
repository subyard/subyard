{
  "schema_version": 1,
  "components": [
    {
      "id": "aiobserver",
      "kind": "integration",
      "settings": [
        "AI_OBSERVER_HOST_PORT"
      ],
      "adoption_keys": [
        "user.subyard.ai_observer_provision",
        "user.subyard.ai_observer_proxy",
        "user.subyard.deferred_publication.ai-observer"
      ],
      "route": {
        "marker_key": "user.subyard.ai_observer_proxy",
        "device_name": "ai-observer",
        "guest_port": 8080,
        "guard": true
      }
    },
    {
      "id": "paseo",
      "kind": "integration",
      "settings": [
        "AGENT_paseo_CHECK",
        "AGENT_paseo_CLEANUP",
        "AGENT_paseo_COMMAND",
        "AGENT_paseo_CONFIG",
        "AGENT_paseo_CONFIG_DEST",
        "AGENT_paseo_DEPENDS",
        "AGENT_paseo_HEALTH",
        "AGENT_paseo_PERSIST",
        "AGENT_paseo_PROJECTS_CHANGED",
        "AGENT_paseo_PROVISION",
        "AGENT_paseo_RULES",
        "AGENT_paseo_RULES_DEST"
      ]
    },
    {
      "id": "openlit",
      "kind": "profile",
      "settings": [
        "OPENLIT_HOST_PORT"
      ],
      "route": {
        "marker_key": "user.subyard.openlit_dashboard",
        "device_name": "openlit-dashboard",
        "guest_port": 3000,
        "defer": true
      }
    }
  ]
}
