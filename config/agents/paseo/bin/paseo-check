#!/usr/bin/env bash
set -euo pipefail

PASEO_VERSION=0.2.1
NODE_VERSION=22.20.0
PASEO_HOME="${PASEO_HOME:-/srv/agents/paseo}"
PASEO_INSTALL_ROOT="${PASEO_INSTALL_ROOT:-/opt/subyard/paseo/current}"
PASEO_DEV_USER="${PASEO_DEV_USER:-@DEV_USER@}"
PASEO_DEV_HOME="${PASEO_DEV_HOME:-@DEV_HOME@}"
PASEO_UNIT="${PASEO_UNIT:-paseo.service}"
PASEO_UNIT_WAIT_SECONDS="${PASEO_UNIT_WAIT_SECONDS:-60}"
PASEO_HEALTH_WAIT_SECONDS="${PASEO_HEALTH_WAIT_SECONDS:-30}"
PASEO_RELAY_WAIT_SECONDS="${PASEO_RELAY_WAIT_SECONDS:-60}"
CONFIG="$PASEO_HOME/config.json"

die() { printf 'Paseo check: %s\n' "$*" >&2; exit 1; }
as_dev() {
  if [ "$(id -un)" = "$PASEO_DEV_USER" ]; then
    env HOME="$PASEO_DEV_HOME" CODEX_HOME="$PASEO_DEV_HOME/.codex" \
      PASEO_HOME="$PASEO_HOME" "$@"
  else
    command -v runuser >/dev/null 2>&1 || die "runuser is required for user switching"
    runuser -u "$PASEO_DEV_USER" -- env HOME="$PASEO_DEV_HOME" \
      CODEX_HOME="$PASEO_DEV_HOME/.codex" PASEO_HOME="$PASEO_HOME" "$@"
  fi
}

for command in curl grep journalctl jq mktemp readlink sha256sum ss stat systemctl; do
  command -v "$command" >/dev/null 2>&1 || die "$command is required"
done

[ -L "$PASEO_INSTALL_ROOT" ] || die "active runtime link is missing"
runtime="$(readlink -f "$PASEO_INSTALL_ROOT")"
case "$runtime" in /opt/subyard/paseo/releases/*) ;; *) die "active runtime link is unsafe" ;; esac
[ -x "$runtime/node/bin/node" ] || die "pinned Node runtime is missing"
[ "$("$runtime/node/bin/node" --version)" = "v$NODE_VERSION" ] || die "Node version drift"
jq -e --arg version "$PASEO_VERSION" '
  .schemaVersion == 1 and .kind == "paseo-headless" and .paseoVersion == $version and
  .nodeVersion == "22.20.0" and .os == "linux" and
  (.arch == "amd64" or .arch == "arm64")
' "$runtime/manifest.json" >/dev/null || die "runtime manifest mismatch"
(cd "$runtime" && sha256sum -c files.sha256 >/dev/null) \
  || die "runtime file checksum mismatch"

[ "$(stat -c '%a|%u:%g' "$CONFIG")" = "644|0:0" ] || die "config ownership or mode drift"
jq -e '
  .version == 1 and
  .daemon.listen == "127.0.0.1:6767" and
  .daemon.relay.enabled == true and
  .daemon.relay.endpoint == "relay.paseo.sh:443" and
  .daemon.relay.publicEndpoint == "relay.paseo.sh:443" and
  .daemon.relay.useTls == true and
  .daemon.relay.publicUseTls == true and
  .app.baseUrl == "https://app.paseo.sh" and
  .features.webUi.enabled == false and
  (.daemon.serviceProxy.listen // null) == null and
  (.daemon.serviceProxy.publicBaseUrl // null) == null
' "$CONFIG" >/dev/null || die "config drift"

systemctl is-enabled --quiet "$PASEO_UNIT" || die "unit is not enabled"
unit_deadline=$((SECONDS + PASEO_UNIT_WAIT_SECONDS))
until systemctl is-active --quiet "$PASEO_UNIT"; do
  systemctl is-failed --quiet "$PASEO_UNIT" && die "unit failed during activation"
  [ "$SECONDS" -lt "$unit_deadline" ] || die "unit did not become active"
  sleep 1
done
[ "$(systemctl show "$PASEO_UNIT" -p User --value)" = "$PASEO_DEV_USER" ] \
  || die "unit does not run as $PASEO_DEV_USER"
main_pid="$(systemctl show "$PASEO_UNIT" -p MainPID --value)"
case "$main_pid" in ''|0|*[!0-9]*) die "unit has no main process" ;; esac
[ "$(stat -c %U "/proc/$main_pid")" = "$PASEO_DEV_USER" ] || die "process user drift"

health=''
health_deadline=$((SECONDS + PASEO_HEALTH_WAIT_SECONDS))
until health="$(curl --fail --silent --max-time 5 http://127.0.0.1:6767/api/health 2>/dev/null)"; do
  [ "$SECONDS" -lt "$health_deadline" ] || die "local health endpoint is unavailable"
  sleep 1
done
jq -e '.status == "ok"' <<<"$health" >/dev/null || die "local health response is invalid"
listeners="$(ss -H -ltn 'sport = :6767' 2>/dev/null || true)"
[ -n "$listeners" ] || die "local listener is missing"
if awk '{print $4}' <<<"$listeners" | grep -Ev '^(127[.]0[.]0[.]1:6767|\\[::1\\]:6767)$' | grep -q .; then
  die "daemon has a non-loopback listener"
fi

status_file="$(mktemp)"
pair_file="$(mktemp)"
cleanup() { rm -f -- "$status_file" "$pair_file"; }
trap cleanup EXIT HUP INT TERM
chmod 0600 "$status_file" "$pair_file"
as_dev /usr/local/bin/paseo daemon status --home "$PASEO_HOME" --json >"$status_file" \
  || die "daemon status failed"
jq -e --arg version "$PASEO_VERSION" '
  .localDaemon == "running" and .connectedDaemon == "reachable" and
  .cliVersion == $version and .daemonVersion == $version and
  .listen == "127.0.0.1:6767" and
  .relay == "wss://relay.paseo.sh:443"
' "$status_file" >/dev/null || die "daemon status or version drift"
as_dev /usr/local/bin/codex-check \
  || die "Codex provider capability is unavailable to $PASEO_DEV_USER"

for identity in server-id daemon-keypair.json; do
  [ -e "$PASEO_HOME/$identity" ] || die "$identity is missing"
  [ "$(stat -c '%a|%U' "$PASEO_HOME/$identity")" = "600|$PASEO_DEV_USER" ] \
    || die "$identity permissions drift"
done

# The offer is a trust anchor. Validate it only in a protected temporary file and never echo it.
as_dev /usr/local/bin/paseo daemon pair --home "$PASEO_HOME" --json >"$pair_file" \
  || die "pairing offer generation failed"
jq -e '
  .relayEnabled == true and
  (.url | startswith("https://app.paseo.sh/#offer=")) and
  (.qr | type == "string" and length > 0)
' "$pair_file" >/dev/null || die "pairing offer contract drift"

invocation="$(systemctl show "$PASEO_UNIT" -p InvocationID --value)"
case "$invocation" in ''|*[!0-9a-f]*) die "unit invocation ID is unavailable" ;; esac
deadline=$((SECONDS + PASEO_RELAY_WAIT_SECONDS))
while ! journalctl --quiet --no-pager -o cat "_SYSTEMD_INVOCATION_ID=$invocation" \
  | grep -F '"msg":"relay_control_connected"' >/dev/null; do
  [ "$SECONDS" -lt "$deadline" ] || die "relay control connection is not ready"
  sleep 1
done

as_dev /usr/local/bin/paseo-sync-projects --force \
  || die "project discovery reconcile failed"
printf 'Paseo %s is ready\n' "$PASEO_VERSION"
