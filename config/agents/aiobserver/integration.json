  "dashboard": {"scheme": "http", "path": "/", "port_setting": "AI_OBSERVER_HOST_PORT", "guest_port": 8080, "container_route": {"marker_key": "user.subyard.ai_observer_proxy", "device_name": "ai-observer"}}
