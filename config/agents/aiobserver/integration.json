{
  "schema_version": 1,
  "inputs": [
    {"name": "AI_OBSERVER_IMAGE", "type": "image-reference", "value": "tobilg/ai-observer:0.6.0@sha256:01c84f99157f5a5688bcf7c96cd01fe24d56958c16d711d8f1afc05c43d8993a"},
    {"name": "AI_OBSERVER_VERSION", "type": "version", "value": "0.6.0"}
