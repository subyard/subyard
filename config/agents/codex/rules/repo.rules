# Codex command rules for the yard (laid down at ~/.codex/rules/repo.rules).
# Commit/push approval lives in the managed requirements that provisioning installs.
# These argv-prefix rules are not a boundary for other Git spellings or direct Git metadata writes.
# Routine local work (edits, builds, tests,
# git reset) stays free.

# Full filesystem access alone still leaves rm subject to Codex's dangerous-command fallback.
# The yard is the isolation boundary, so local file removal needs an explicit allow rule.
prefix_rule(
    pattern = ["rm"],
    decision = "allow",
    match = ["rm -rf -- .build/fixture-hardening", "rm generated-file"],
)
