# Typed persistent settings example
#
# `yard config fields [SETTING]` is the generated field reference: it prints the effective shipped
# default, type, allowed scopes, syncability, application mode and domain owner from the production
# catalog. Uncomment only fields needed in the selected shared, host or yard scope. Unknown fields,
# wrong scopes, invalid types and secret-like values fail closed.
#
# Optional shared example:
#   shared/config.env -> $SUBYARD_CONFIG_HOME/overrides/shared/config.env
# Optional selected-host example:
#   hosts/<HostID>/config.env -> $SUBYARD_CONFIG_HOME/config.env
# Yard example:
#   hosts/<HostID>/yards/<yard>/config.env
#
# A committed subyard-config.json is sufficient for an empty desired state. Do not add empty host
# marker files: hosts/<HostID>/ is needed only for real host or yard differences, and config.env is
# optional unless it is the scalar definition inside an existing yards/<yard>/ entry.
#
# scalar port; scopes=host,yard; syncable=yes; applies=next command
# ADB_CONSOLE_EMULATOR_PORT=
# ADB_CONSOLE_PROXY_PORT=
# ADB_EMULATOR_PORT=5555
# ADB_PROXY_PORT=15555
# ORCA_HOST_PORT=
# HERMES_DASHBOARD_HOST_PORT=
# SSH_PORT=2222
#
# scalar name/list/image; scopes vary; see `yard config fields`
# Agent dependencies are expanded automatically (for example, paseo adds codex).
# CODING_TOOL_INTEGRATIONS="claude codex opencode pi"
# YARD_IMAGE=images:debian/13
# YARD_IMAGE_FALLBACK=images:ubuntu/24.04
# DEV_USER=dev
# ENVIRONMENT_PROFILES="openclaw"
# YARD_TEMPLATE=test-vms
#
# scalar boolean; host/yard only; syncable=yes; applies=yard init
# DEV_SUDO=0
# FORWARD_SSH_AGENT=1
# NESTED_E2E_VMS=0
#
# Opt-in exact owner routes. Orca also supports 127.0.0.1 with ssh -L; Hermes requires Tailscale.
# ORCA_ADVERTISE_HOST=owner.example-tailnet.ts.net
# HERMES_DASHBOARD_ADVERTISE_HOST=owner.example-tailnet.ts.net
#
# scalar integer/size; scopes vary; syncable=yes
# DEV_UID=1000
# E2E_VM_BOOT_TIMEOUT=300
# E2E_VM_CPU=4
# E2E_VM_DISK=20GiB
# E2E_VM_MEMORY=4GiB
# E2E_VM_SLOT_COUNT=2
# LIMITS_CPU=8
# LIMITS_MEMORY=24GiB
#
# scalar image/version/digest; see `yard config fields` for exact scopes
# E2E_VM_IMAGE=images:debian/13/cloud
# CCUSAGE_VERSION=20.0.20
# CCUSAGE_SHA256_AMD64=
# CCUSAGE_SHA256_ARM64=
# CODEX_VERSION=0.147.0
# CODEX_SHA256_AMD64=
# CODEX_SHA256_ARM64=
# SUBYARD_AGE_VERSION=1.3.1
# SUBYARD_AGE_SHA256_AMD64=
# SUBYARD_AGE_SHA256_ARM64=
# SUBYARD_SOPS_VERSION=3.13.2
# SUBYARD_SOPS_SHA256_AMD64=
# SUBYARD_SOPS_SHA256_ARM64=
#
# host/yard infrastructure settings. Identity and local-only fields are intentionally not
# syncable even though the production resolver accepts them at their documented local boundary.
# HOST_BASE=/srv/subyard
# HOST_CLAUDE_MD=/home/operator/.claude/CLAUDE.md
# HOST_CODEX_AGENTS_MD=/home/operator/.codex/AGENTS.md
# HOST_LINKS=
# HOST_MOUNTS=
# HOST_OPENCODE_AGENTS_MD=/home/operator/.config/opencode/AGENTS.md
# INCUS_BRIDGE=incusbr0
# INCUS_PROJECT=subyard
# YARD_INSTANCE_NAME=yard
# YARD_KIND=container
# OWNER_ENDPOINT=operator@example
# REMOTE_DEV_USER=dev
# REMOTE_SSH_PORT=22
# OWNER_YARD_NAME=default
# RESTRICTED_DISK_PATHS=/srv/subyard
# SHIFT_MODE=shift
# SRV_POOL=default
# SRV_VOLUME=yard-srv
# SSH_HOST=yard
# STORAGE_PATH=/home/operator/.subyard/incus/storage
# YARD_CAPABILITIES=
# YARD_CAPS=
# YARD_DEVICES=
# YARD_MOUNTS=
# ACCESS_KIND=local
#
# Local support-tool and credential paths are not versioned-sync inputs.
# CCUSAGE_PROVISION=/runtime/config/agents/ccusage/provision.sh
# SUBYARD_KEYS_CONSUMER_ROOT=/home/operator/.config/subyard/generated
# SUBYARD_KEYS_ROOT=/home/operator/.config/subyard/keys
# SUBYARD_KEYS_SYSTEMD_DIR=/home/operator/.config/systemd/user
# SUBYARD_KEYS_TOOLS_DIR=/home/operator/.config/subyard/tools
# SUBYARD_POWER_LIBEXEC_DIR=/usr/local/libexec/subyard
# SUBYARD_POWER_RECONCILER_PATH=/usr/local/libexec/subyard/yard-boot-reconcile
# SUBYARD_POWER_UNIT_PATH=/etc/systemd/system/subyard-power-reconcile.service
#
# File settings are represented by regular files under overrides/agents, not by path assignments
# in a versioned config.env. Supported package patterns:
# AGENT_<name>_CONFIG
# AGENT_<name>_RULES
# AGENT_<name>_CONFIG_DEST
# AGENT_<name>_RULES_DEST
# AGENT_<name>_PROVISION
# AGENT_<name>_COMMAND
# AGENT_<name>_CHECK
# AGENT_<name>_PROJECTS_CHANGED
# AGENT_<name>_PERSIST
