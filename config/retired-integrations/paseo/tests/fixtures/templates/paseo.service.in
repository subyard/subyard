[Unit]
Description=Paseo coding-agent daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=@DEV_USER@
Group=@DEV_USER@
Environment=HOME=@DEV_HOME@
Environment=PASEO_HOME=/srv/agents/paseo
Environment=PASEO_LISTEN=127.0.0.1:6767
Environment=PASEO_RELAY_ENABLED=true
Environment=PASEO_RELAY_ENDPOINT=relay.paseo.sh:443
Environment=PASEO_RELAY_PUBLIC_ENDPOINT=relay.paseo.sh:443
Environment=PASEO_RELAY_USE_TLS=true
Environment=PASEO_RELAY_PUBLIC_USE_TLS=true
Environment=PASEO_APP_BASE_URL=https://app.paseo.sh
Environment=PASEO_WEB_UI_ENABLED=false
Environment=PASEO_LOCAL_SPEECH_AUTO_DOWNLOAD=false
Environment=PASEO_DICTATION_ENABLED=false
Environment=PASEO_VOICE_MODE_ENABLED=false
Environment=PASEO_LOG_FORMAT=json
ExecStart=/usr/local/bin/paseo daemon start --foreground --home /srv/agents/paseo --listen 127.0.0.1:6767 --relay-use-tls --no-web-ui
ExecStartPost=/usr/local/bin/paseo-sync-projects --wait --force
Restart=on-failure
RestartSec=5s
TimeoutStartSec=75s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DEV_HOME@ /srv/agents/paseo /srv/workspaces

[Install]
WantedBy=multi-user.target
