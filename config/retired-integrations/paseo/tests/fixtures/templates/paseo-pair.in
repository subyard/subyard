#!/usr/bin/env bash
set -euo pipefail

PASEO_HOME="${PASEO_HOME:-/srv/agents/paseo}"
PASEO_DEV_USER="${PASEO_DEV_USER:-@DEV_USER@}"
PASEO_DEV_HOME="${PASEO_DEV_HOME:-@DEV_HOME@}"

if [ "$(id -un)" = "$PASEO_DEV_USER" ]; then
  exec env HOME="$PASEO_DEV_HOME" PASEO_HOME="$PASEO_HOME" \
    /usr/local/bin/paseo daemon pair --home "$PASEO_HOME"
fi

[ "$(id -u)" -eq 0 ] \
  || { printf 'paseo-pair: run this command as %s\n' "$PASEO_DEV_USER" >&2; exit 1; }
exec runuser -u "$PASEO_DEV_USER" -- env HOME="$PASEO_DEV_HOME" PASEO_HOME="$PASEO_HOME" \
  /usr/local/bin/paseo daemon pair --home "$PASEO_HOME"
