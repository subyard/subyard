#!/usr/bin/env bash
set -euo pipefail

PASEO_HOME="${PASEO_HOME:-/srv/agents/paseo}"
PASEO_DEV_USER="${PASEO_DEV_USER:-@DEV_USER@}"
ASSUME_YES=0

case "${1:-}" in
  '') ;;
  --yes) ASSUME_YES=1 ;;
  *) printf 'Usage: paseo-rotate-identity [--yes]\n' >&2; exit 2 ;;
esac
[ "$(id -u)" -eq 0 ] || { printf 'paseo-rotate-identity: root is required\n' >&2; exit 1; }

printf '%s\n' \
  'This will:' \
  '  - stop the Paseo daemon;' \
  '  - replace its server ID and E2E daemon keypair;' \
  '  - invalidate every existing Paseo client connection;' \
  '  - require explicit pairing of every client again.'
if [ "$ASSUME_YES" = 0 ]; then
  printf 'Proceed? [y/N] '
  read -r answer
  case "$answer" in y|Y|yes|YES) ;; *) printf 'Cancelled.\n'; exit 1 ;; esac
fi

backup="$PASEO_HOME/rotated-identity/$(date -u +%Y%m%dT%H%M%SZ)-$$"
install -d -m 0700 -o "$PASEO_DEV_USER" -g "$PASEO_DEV_USER" "$backup"
systemctl stop paseo.service
for identity in server-id daemon-keypair.json; do
  [ ! -e "$PASEO_HOME/$identity" ] || mv -- "$PASEO_HOME/$identity" "$backup/$identity"
done
if systemctl start paseo.service && /usr/local/bin/paseo-check >/dev/null; then
  rm -rf -- "$backup"
  printf 'Paseo identity rotated. Run paseo-pair and re-pair every client.\n'
  exit 0
fi

systemctl stop paseo.service || true
for identity in server-id daemon-keypair.json; do
  [ ! -e "$backup/$identity" ] || mv -- "$backup/$identity" "$PASEO_HOME/$identity"
done
systemctl start paseo.service || true
printf 'paseo-rotate-identity: rotation failed; previous identity restored\n' >&2
exit 1
