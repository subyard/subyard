#!/usr/bin/env bash
set -euo pipefail

PASEO_INSTALL_ROOT="${PASEO_INSTALL_ROOT:-/opt/subyard/paseo/current}"
NODE="$PASEO_INSTALL_ROOT/node/bin/node"
CLI="$PASEO_INSTALL_ROOT/app/node_modules/@getpaseo/cli/bin/paseo"

[ -x "$NODE" ] || { printf 'paseo: pinned Node runtime is missing\n' >&2; exit 1; }
[ -f "$CLI" ] || { printf 'paseo: pinned CLI is missing\n' >&2; exit 1; }
exec "$NODE" "$CLI" "$@"
