#!/usr/bin/env bash
set -euo pipefail

PASEO_INSTALL_ROOT="${PASEO_INSTALL_ROOT:-/opt/subyard/paseo/current}"
PASEO_HOME="${PASEO_HOME:-/srv/agents/paseo}"
PASEO_SYNC_WAIT_SECONDS="${PASEO_SYNC_WAIT_SECONDS:-30}"
NODE="$PASEO_INSTALL_ROOT/node/bin/node"
HELPER="$PASEO_INSTALL_ROOT/app/libexec/paseo-sync-projects.mjs"

[ -x "$NODE" ] || { printf 'paseo-sync-projects: pinned Node runtime is missing\n' >&2; exit 1; }
[ -f "$HELPER" ] || { printf 'paseo-sync-projects: helper is missing\n' >&2; exit 1; }

if [ "${1:-}" = "--wait" ]; then
  shift
  deadline=$((SECONDS + PASEO_SYNC_WAIT_SECONDS))
  until curl --fail --silent --max-time 2 http://127.0.0.1:6767/api/health >/dev/null 2>&1; do
    [ "$SECONDS" -lt "$deadline" ] \
      || { printf 'paseo-sync-projects: local daemon did not become ready\n' >&2; exit 1; }
    sleep 1
  done
fi

install -d -m 0700 "$PASEO_HOME"
exec 9>"$PASEO_HOME/subyard-project-sync.lock"
if ! flock -n 9; then
  printf 'paseo-sync-projects: another sync is already running\n' >&2
  exit 0
fi
exec "$NODE" "$HELPER" "$@"
