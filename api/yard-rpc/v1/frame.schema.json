{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "request"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "params": {}
      },
      "required": [
        "version",
        "type",
        "id",
        "method"
      ],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "cancel"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "method": {
          "type": "string",
          "maxLength": 8192
        },
        "params": {}
      },
      "required": [
        "version",
        "type",
        "id",
        "operationId"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "response"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "result": {},
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 8192
            },
            "message": {
              "type": "string",
              "maxLength": 8192
            },
            "data": {
              "$ref": "#/$defs/errorData"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        "event": {
          "type": "string",
          "maxLength": 8192
        },
        "data": {}
      },
      "required": [
        "version",
        "type",
        "id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "result",
              "error"
            ]
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "event"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "data": {}
      },
      "required": [
        "version",
        "type",
        "sequence",
        "revision",
        "event"
      ],
      "additionalProperties": false
    },
    "errorData": {
      "description": "Typed, value-free refusals of an error. Optional; clients that do not support it ignore it.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "refusals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/refusal"
          }
        },
        "omitted": {
          "type": "integer",
          "minimum": 1
        },
        "incomplete": {
          "const": true
        },
        "gate": {
          "type": "object",
          "description": "Public release-gate outcome of a gate refusal; its blockers are the refusals.",
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "active": {
              "type": "string",
              "maxLength": 128
            },
            "previous": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "target": {
              "type": "string",
              "maxLength": 128
            },
            "transaction": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "action": {
              "type": "string",
              "maxLength": 512
            },
            "decisions": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/gateDecision"
              }
            },
            "omittedDecisions": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "status",
            "code",
            "active",
            "target",
            "action"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "refusals"
      ]
    },
    "gateDecision": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "maxLength": 128
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision": {
          "type": "string",
          "maxLength": 128
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "resource",
        "decision"
      ],
      "additionalProperties": false
    },
    "refusal": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "config",
            "release-gate"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "next": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "action": {
          "type": "object",
          "properties": {
            "verb": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "yard": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "verb",
            "command"
          ]
        }
      },
      "required": [
        "source",
        "code",
        "text"
      ]
    }
  }
}
