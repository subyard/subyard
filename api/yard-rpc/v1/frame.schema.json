{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "request"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "params": {}
      },
      "required": [
        "version",
        "type",
        "id",
        "method"
      ],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "cancel"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "method": {
          "type": "string",
          "maxLength": 8192
        },
        "params": {}
      },
      "required": [
        "version",
        "type",
        "id",
        "operationId"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "response"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "result": {},
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 8192
            },
            "message": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        "event": {
          "type": "string",
          "maxLength": 8192
        },
        "data": {}
      },
      "required": [
        "version",
        "type",
        "id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "result",
              "error"
            ]
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "event"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "data": {}
      },
      "required": [
        "version",
        "type",
        "sequence",
        "revision",
        "event"
      ],
      "additionalProperties": false
    }
  }
}
