          "properties": {
            "command": {
              "type": "string",
              "maxLength": 8192
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 8192
              },
              "maxItems": 1024
            },
            "exact": {
              "type": "boolean"
            },
            "stepSchema": {
              "enum": [
                0,
                1
              ]
            },
            "source": {
              "type": "object",
              "properties": {
                "schema": {
                  "const": 1
                },
                "source": {
                  "type": "string"
                },
                "archiveDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "archiveSize": {
                  "type": "integer",
                  "minimum": 1
                },
                "treeDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "requestedName": {
                  "type": "string"
                },
                "explicitName": {
                  "type": "boolean"
                },
                "targetProfile": {
                  "type": "string"
                }
              },
              "required": [
                "schema",
                "source",
                "archiveDigest",
                "archiveSize",
                "treeDigest",
                "requestedName",
                "explicitName",
                "targetProfile"
              ],
              "additionalProperties": false
            },
            "export": {
              "type": "object",
              "properties": {
                "schema": {
                  "const": 1
                },
                "projectId": {
                  "type": "string"
                },
                "sourceKey": {
                  "type": "string"
                },
                "archiveDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "archiveSize": {
                  "type": "integer",
                  "minimum": 1
                },
                "sourceTree": {
                  "type": "string"
                },
                "destination": {
                  "type": "string"
                },
                "destinationBinding": {
                  "type": "string"
                }
              },
              "required": [
                "schema",
                "projectId",
                "sourceKey",
                "archiveDigest",
                "archiveSize",
                "sourceTree",
                "destination",
                "destinationBinding"
              ],
              "additionalProperties": false
            },
            "targetYard": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "maxLength": 8192,
              "not": {
                "const": "default"
              },
              "description": "Only exact init with --profile; retains the native bootstrap on the existing owner session."
            }
          },
          "required": [
            "command",
            "arguments"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "targetYard"
                ]
              },
              "then": {
                "properties": {
                  "command": {
                    "const": "init"
                  },
                  "exact": {
                    "const": true
                  },
                  "arguments": {
                    "minItems": 2,
                    "contains": {
                      "const": "--profile"
                    }
                  }
                },
                "required": [
                  "exact"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "source"
                      ]
                    },
                    {
                      "required": [
                        "export"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
