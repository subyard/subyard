[Unit]
Description=Restore guarded Subyard desired power state
Wants=network-online.target incus.service incus.socket
After=network-online.target NetworkManager.service incus.service incus.socket
# Login-unlocked storage and local proxy addresses can be unavailable indefinitely.
# Only temporary exit 75 retries; each attempt and the retry rate stay bounded.
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=@SUBYARD_POWER_RECONCILER@ _power-reconcile
TimeoutStartSec=120
RuntimeMaxSec=120
Restart=no
SuccessExitStatus=75
RestartForceExitStatus=75
RestartSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/lock

[Install]
WantedBy=multi-user.target
