{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subyard Veranda",
  "version": "0.1.0",
  "identifier": "com.subyard.veranda",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Subyard Veranda",
        "width": 1180,
        "height": 760,
        "minWidth": 320,
        "minHeight": 520
      }
    ],
    "security": {
      "capabilities": ["main-read-only"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
